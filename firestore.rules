rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection with optimized pagination
    match /users/{userId} {
      // Allow read/write for own user document
      allow read, write: if isAuthenticated() 
        && request.auth.uid == userId;
      
      // Allow admin to read all users with pagination limits
      allow read: if isAdmin()
        && request.query.limit <= 50;
      
      // Allow admin to write user data
      allow write: if isAdmin();
    }
    
    // Documents collection with optimized queries and pagination
    match /documents/{documentId} {
      // Allow single document read for authenticated users
      allow get: if isAuthenticated();

      // Allow collection queries for authenticated users with pagination limits
      allow list: if isAuthenticated()
        && request.query.limit <= 25;

      // Allow write for document owner
      allow write: if isAuthenticated()
        && request.auth.uid == resource.data.uploadedBy;

      // Allow create for authenticated users
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.uploadedBy
        && request.resource.data.keys().hasAll(['fileName', 'uploadedAt', 'isActive']);

      // Optimized batch operations with strict limits
      allow list: if isAuthenticated()
        && request.query.limit <= 10
        && 'isActive' in request.query.where
        && request.query.where.isActive == true;

      // Allow admin to delete documents
      allow delete: if isAdmin();
    }
    
    // Categories collection
    match /categories/{categoryId} {
      // Allow single document read for authenticated users
      allow get: if isAuthenticated();

      // Allow collection queries for authenticated users with pagination
      allow list: if isAuthenticated()
        && request.query.limit <= 50;

      // Only admin can write categories
      allow write: if isAdmin();
    }
    
    // Activities collection with time-based cleanup support
    match /activities/{activityId} {
      // Allow single document read for authenticated users
      allow get: if isAuthenticated();

      // Allow collection queries for recent activities only with pagination
      allow list: if isAuthenticated()
        && request.query.limit <= 20
        && request.query.orderBy == 'timestamp';

      // Allow create for authenticated users
      allow create: if isAuthenticated();

      // Allow admin to delete old activities (for cleanup)
      allow delete: if isAdmin();
    }
    
    // Processing queue collection removed since status management is removed
  }
}
