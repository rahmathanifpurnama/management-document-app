{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "testlab": {
    "matrices": {
      "android": {
        "device": [
          {
            "model": "Pixel2",
            "version": "28"
          },
          {
            "model": "Pixel3",
            "version": "30"
          },
          {
            "model": "Pixel4",
            "version": "31"
          }
        ],
        "locale": ["en"],
        "orientation": ["portrait", "landscape"]
      },
      "ios": {
        "device": [
          {
            "model": "iphone13pro",
            "version": "15.7"
          },
          {
            "model": "iphone14",
            "version": "16.6"
          }
        ],
        "locale": ["en"],
        "orientation": ["portrait"]
      }
    }
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
